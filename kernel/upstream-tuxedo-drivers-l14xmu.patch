+static DEFINE_MUTEX(clevo_legacy_fc_lock);
+static bool clevo_legacy_fc_initialized = false;
+static u8 clevo_legacy_fc_start = 40;
+static u8 clevo_legacy_fc_end = 100;
+static u8 clevo_legacy_fc_status = 0;
+
+static int clevo_legacy_flexicharger_ensure_init_locked(void)
+{
+	u32 data = 0;
+	int result;
+	u8 hw_start, hw_end, hw_status;
+
+	if (clevo_legacy_fc_initialized)
+		return 0;
+
+	/*
+	 * Method 0x77 returns static boot-time BIOS NVRAM (CONV: BAEE, BSCP, BTCP);
+	 * DSDT does not update NVRAM on ZEVT(0x41, ...0xCB), so keep shadow state.
+	 */
+	result = clevo_evaluate_method(0x77, 0, &data);
+	if (result != 0)
+		return result;
+
+	hw_status = data & 0x01;
+	hw_start = (data >> 0x08) & 0xff;
+	hw_end = (data >> 0x10) & 0xff;
+
+	if (hw_start >= 40 && hw_start <= 95 &&
+	    hw_end >= 60 && hw_end <= 100 &&
+	    hw_start < hw_end) {
+		clevo_legacy_fc_start = hw_start;
+		clevo_legacy_fc_end = hw_end;
+		clevo_legacy_fc_status = hw_status;
+	} else {
+		clevo_legacy_fc_start = 40;
+		clevo_legacy_fc_end = 100;
+		clevo_legacy_fc_status = 0;
+	}
+
+	clevo_legacy_fc_initialized = true;
+	return 0;
+}
